+def _pending(rows, uid_of, done):
+    """Items still to do, in dataset order, with any duplicate uid dropped.
+
+    The sequential loops added each uid to `done` as they went, which also protected against the
+    same uid appearing twice in one shard. Filtering up front has to keep that property, or a
+    duplicate would be called twice and written twice.
+    """
+    seen = set(done)
+    out = []
+    for item in rows:
+        uid = uid_of(item)
+        if uid in seen:
+            continue
+        seen.add(uid)
+        out.append((uid, item))
+    return out
+
+
+def _run_items(pending, work, checkpoint, results, save_every, concurrency):
+    """Run work(uid, item) over `pending`, sequentially or across a thread pool.
+
+    Rows are appended to `results` in **dataset order**, never completion order, so a run's CSV does
+    not depend on which call happened to finish first. Two runs of the same shard at different
+    concurrencies produce the same file.
+
+    concurrency == 1 is the original code path, byte for byte: append as you go, checkpoint every
+    `save_every`. The five existing runners never pass anything else, so they are untouched.
+
+    Above 1, three things have to hold that the sequential loop got for free:
+
+    - **Completed work survives an abort.** A halt raised inside a worker must not discard the rows
+      other workers already finished, so results are extended in a `finally` and the exception is
+      re-raised afterwards.
+    - **A halt actually stops the run.** `_halt` raises SystemExit, which in a worker thread ends
+      only that thread; the pool would calmly run the remaining 14,000 items against a provider that
+      is refusing every call. The stop Event makes queued items return immediately.
+    - **Checkpoint writes are serialised.** Two threads writing the same .jsonl interleave lines and
+      corrupt the file that resume depends on.
+    """
+    if concurrency <= 1:
+        for uid, item in pending:
+            results.append(work(uid, item))
+            if len(results) % save_every == 0:
+                save_checkpoint(checkpoint, results)
+        return
+
+    slots = [None] * len(pending)
+    save_lock = threading.Lock()
+    stop = threading.Event()
+    state = {"done": 0}
+
+    def run_one(indexed):
+        position, (uid, item) = indexed
+        if stop.is_set():
+            return
+        try:
+            slots[position] = work(uid, item)
+        except BaseException:
+            stop.set()
+            raise
+        with save_lock:
+            state["done"] += 1
+            if state["done"] % save_every == 0:
+                save_checkpoint(checkpoint, results + [s for s in slots if s is not None])
+
+    error = None
+    try:
+        with ThreadPoolExecutor(max_workers=concurrency) as pool:
+            for _ in pool.map(run_one, list(enumerate(pending))):
+                pass
+    except BaseException as exc:
+        error = exc
+    finally:
+        results.extend(s for s in slots if s is not None)
+    if error is not None:
+        raise error
+
